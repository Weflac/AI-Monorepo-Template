{
  "name": "@repo/backend",
  "version": "0.1.0",
  "private": true,
  "description": "FastAPI backend (Python/uv). This package.json only wires the app into pnpm/turbo scripts.",
  "scripts": {
    "setup": "uv sync",
    "dev": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "test": "uv run pytest",
    "lint": "uv run ruff check . --fix",
    "typecheck": "uv run mypy app",
    "clean": "rimraf .turbo .pytest_cache"
  }
}
